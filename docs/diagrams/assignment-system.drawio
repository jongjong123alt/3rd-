        </mxCell>
        <mxCell id="dashboard" value="&lt;b&gt;대시보드&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;GET / (로그인)&lt;br&gt;오늘 할 일·가까운 마감·요약&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#E9F2EB;strokeColor=#7BA58A;strokeWidth=1.5;fontColor=#24352E;fontSize=15;fontFamily=Noto Sans CJK KR;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
