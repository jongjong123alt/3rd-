        </mxCell>
        <mxCell id="legacy" value="&lt;b&gt;기존 공개 예시 경로&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;GET /preview/&amp;lt;slug&amp;gt;&lt;br&gt;고정 예시 데이터 · 주요 메뉴에서는 미노출&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#24352E;fontSize=15;fontFamily=Noto Sans CJK KR;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
