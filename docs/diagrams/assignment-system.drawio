        <mxCell id="browser" value="&lt;b&gt;사용자 브라우저&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;HTML / CSS / JavaScript&lt;br&gt;서명된 세션 쿠키 전송&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#24352E;fontSize=15;fontFamily=Noto Sans CJK KR;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
