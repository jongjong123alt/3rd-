        <mxCell id="landing" value="&lt;b&gt;서비스 소개&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;GET / (비로그인)&lt;br&gt;기능 소개·사용 방법·AI 안내&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#24352E;fontSize=15;fontFamily=Noto Sans CJK KR;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="55" y="230" width="460" height="105" as="geometry" />
        </mxCell>
        <mxCell id="tour" value="&lt;b&gt;기능 사용 장면&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;GET /features&lt;br&gt;과제 정리 → 체크리스트 → 마감 → AI&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#24352E;fontSize=15;fontFamily=Noto Sans CJK KR;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="55" y="410" width="460" height="105" as="geometry" />
